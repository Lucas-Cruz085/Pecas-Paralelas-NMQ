# Copie para ".env" e preencha (Supabase > Project Settings > API).
# Só valores públicos aqui. A SUPABASE_SERVICE_ROLE_KEY nunca vai para o front nem usa o prefixo VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Opcional: chave pública do Cloudflare Turnstile (captcha após falhas de login).
VITE_TURNSTILE_SITE_KEY=

# Secrets das Edge Functions (cadastre com `supabase secrets set`, nunca neste arquivo):
# ALLOWED_ORIGINS, THROTTLE_HMAC_KEY, TURNSTILE_SECRET_KEY
